# ==========================================
# Velora Markets — Environment Configuration
# ==========================================

# Frontend API Base URL. Keep /api for the Vite proxy (recommended).
# A direct URL is only needed when the frontend and backend are hosted separately.
VITE_API_BASE_URL=/api

# Backend Server Port (defaults to 8080)
PORT=8080

# FinancialModelingPrep (FMP) Market Data API Key
# Required for provider-backed quotes, history, and real-time streaming.
# If unset, market data is reported as DATA_UNAVAILABLE; no simulated fallback is used.
FMP_API_KEY=

# Spring Boot / Database (defaults to local embedded H2 in file:./data/velora)
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/veloradb;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# JWT Secret Token (256-bit+ base64 or secure passphrase)
# JWT_SECRET=velora-markets-super-secure-production-jwt-key-32chars

# Starting Virtual Capital Grant for New Accounts (Default: 100000.00)
# VELORA_PORTFOLIO_STARTING_CASH=100000.00
